  "id": null,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "expr": "sum(increase(laravel_pipeline_node_executions_total[$__range]))",
          "refId": "A"
        }
      ],
      "title": "Pipeline | Execucoes (janela)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, graph_node_id) (rate(laravel_pipeline_node_duration_ms_milliseconds_bucket[5m])))",
          "legendFormat": "{{graph_node_id}}",
          "refId": "A"
        }
      ],
      "title": "Pipeline | Latencia p95 por node",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "id": 3,
      "targets": [
        {
          "expr": "sum by (graph_node_id) (increase(laravel_pipeline_node_cost_usd_total[$__range]))",
          "legendFormat": "{{graph_node_id}}",
          "refId": "A"
        }
      ],
      "title": "Pipeline | Custo USD por node",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "id": 4,
      "targets": [
        {
          "expr": "sum by (graph_node_id, graph_node_status) (increase(laravel_pipeline_node_executions_total[$__range]))",
          "legendFormat": "{{graph_node_id}} {{graph_node_status}}",
          "refId": "A"
        }
      ],
      "title": "Pipeline | Execucoes por status",
      "type": "timeseries"
    }
  ],
