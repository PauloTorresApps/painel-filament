# ========================================
# CONFIGURAÇÃO DOCKER - SISTEMA DE ANÁLISE DE PROCESSOS
# ========================================

APP_NAME="Painel de Análises Jurídicas"
APP_ENV=local
APP_KEY=base64:1lb4Uq6wEod7uH/UI245shrW8qs2V3Nwgc5BiZOkiU4=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8000
APP_PORT=8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ========================================
# DATABASE - PostgreSQL
# ========================================
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=painel
DB_USERNAME=painel_user
DB_PASSWORD=******

# ========================================
# CACHE & SESSION - Redis
# ========================================
CACHE_STORE=redis
CACHE_PREFIX=painel_cache

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0

# ========================================
# QUEUE - Redis
# ========================================
QUEUE_CONNECTION=redis

# ========================================
# FILESYSTEM
# ========================================
FILESYSTEM_DISK=local

# ========================================
# BROADCASTING
# ========================================
BROADCAST_CONNECTION=log

# ========================================
# MAIL
# ========================================
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="olhadinha@painel.local"
MAIL_FROM_NAME="${APP_NAME}"

# ========================================
# E-PROC WEBSERVICE
# ========================================
# URL do webservice MNI do e-Proc
URL_SOAP_WEBSERVICE=https://eproc1g-ws.tjto.jus.br/eprocV2_prod_1grau/ws/intercomunicacao3.0/wsdl/servico-intercomunicacao-3.0.0.wsdl
URL_BASE_WEBSERVICE=https://eproc1g-ws.tjto.jus.br/eprocV2_prod_1grau

# URL_SOAP_WEBSERVICE=https://app8.mpto.mp.br/ws/intercomunicacao3.0/wsdl/servico-intercomunicacao-3.0.0.wsdl
# URL_BASE_WEBSERVICE=https://app8.mpto.mp.br
# ========================================
# WEBSERVICE CNJ
# ========================================
# URL do webservice CNJ para consulta de classes e assuntos
URL_CNJ_WEBSERVICE=https://www.cnj.jus.br/sgt/sgt_ws.php

# ========================================
# AI CONFIGURATION (OpenRouter)
# ========================================
# Modelos de IA são configurados exclusivamente pelo admin
# no cadastro de Prompts (AiPrompt → AiModel) via painel Filament.
AI_BATCH_SIZE=10

OPENROUTER_API_KEY=sk-************************
OPENROUTER_TIMEOUT=300
OPENROUTER_RATE_LIMIT_PER_MINUTE=30

OPENROUTER_MAX_TOKENS=8192
OPENROUTER_MAX_TOKENS_REASONING=32768
OPENROUTER_MAX_TOKENS_REDUCE=16384
OPENROUTER_MAX_TOKENS_FINAL=65000
OPENROUTER_TEMPERATURE=0.3
OPENROUTER_TEMPERATURE_FINAL=0.4
OPENROUTER_TOP_P=0.2

# Chunking de documentos grandes
ANALYSIS_CHUNK_SIZE=500000
ANALYSIS_MIN_CHUNK_SIZE=50000

# Timeouts e limites do pipeline de análise
ANALYSIS_PROCESS_TIMEOUT=1800
ANALYSIS_MAP_TIMEOUT=300
ANALYSIS_CHUNK_TIMEOUT=3600
ANALYSIS_REDUCE_TIMEOUT=600
ANALYSIS_LARGE_DOC_THRESHOLD=100000
ANALYSIS_REFINE_THRESHOLD=20
ANALYSIS_BATCH_SIZE=10
ANALYSIS_MAX_REDUCE_LEVELS=5
ANALYSIS_FAILURE_THRESHOLD=0.25
ANALYSIS_MIN_JOBS_CB=4
ANALYSIS_TOKEN_METHOD=word_count
ANALYSIS_TOKEN_MULTIPLIER=1.3

# Provider Routing
# OPENROUTER_PROVIDER_ORDER=anthropic,google,openai
OPENROUTER_ALLOW_FALLBACKS=true
# OPENROUTER_PROVIDER_SORT=
OPENROUTER_REQUIRE_PARAMETERS=true

# Controle de custos
# OPENROUTER_MAX_PRICE_PROMPT=10
# OPENROUTER_MAX_PRICE_COMPLETION=30

# Transforms
OPENROUTER_TRANSFORMS=middle-out

# Structured Outputs (fase MAP)
OPENROUTER_STRUCTURED_MAP_ENABLED=false

# Web Search (parecer final)
OPENROUTER_WEB_SEARCH_ENABLED=true
OPENROUTER_WEB_SEARCH_MAX_RESULTS=3

# ========================================
# PDF (wkhtmltopdf)
# ========================================
WKHTMLTOPDF_BINARY=/usr/bin/wkhtmltopdf
WKHTMLTOPDF_TIMEOUT=30

# ========================================
# VITE (Frontend Assets)
# ========================================
VITE_APP_NAME="${APP_NAME}"

# ========================================
# DOCKER ESPECÍFICO
# ========================================
USER_ID=1000
GROUP_ID=1000

# OTEL do app (host local)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=meu-app-laravel
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_PHP_AUTOLOAD_ENABLED=true

# OTEL Collector e observabilidade (docker-compose)
TEMPO_ENDPOINT=tempo:4317
PROM_ENDPOINT=0.0.0.0:9090
LOKI_ENDPOINT=http://loki:3100/otlp

# Grafana (docker-compose)
GF_SECURITY_ADMIN_PASSWORD=admin
GF_AUTH_ANONYMOUS_ENABLED=true
GF_AUTH_ANONYMOUS_ORG_ROLE=Admin
GF_AUTH_DISABLE_LOGIN_FORM=true
GF_INSTALL_PLUGINS=https://storage.googleapis.com/integration-artifacts/grafana-exploretraces-app/grafana-exploretraces-app-latest.zip;grafana-traces-app

# MailHog (docker-compose)
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025