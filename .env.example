# ========================================
# CONFIGURAÇÃO DOCKER - SISTEMA DE ANÁLISE DE PROCESSOS
# ========================================

APP_NAME="Painel de Análises Jurídicas"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8000
APP_PORT=8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ========================================
# DATABASE - PostgreSQL
# ========================================
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=painel
DB_USERNAME=painel_user
DB_PASSWORD=strongpassword123

# ========================================
# CACHE & SESSION - Redis
# ========================================
CACHE_STORE=redis
CACHE_PREFIX=painel_cache

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0

# ========================================
# QUEUE - Redis
# ========================================
QUEUE_CONNECTION=redis

# ========================================
# FILESYSTEM
# ========================================
FILESYSTEM_DISK=local

# ========================================
# BROADCASTING
# ========================================
BROADCAST_CONNECTION=log

# ========================================
# MAIL
# ========================================
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@painel.local"
MAIL_FROM_NAME="${APP_NAME}"

# ========================================
# E-PROC WEBSERVICE
# ========================================
# URL do webservice MNI do e-Proc
# URL_SOAP_WEBSERVICE=https://eproc1.tjto.jus.br/eprocV2_prod_1grau/ws/intercomunicacao3.0/wsdl/servico-intercomunicacao-3.0.0.wsdl
# URL_BASE_WEBSERVICE=https://eproc1g-ws.tjto.jus.br/eprocV2_prod_1grau

URL_SOAP_WEBSERVICE=https://app8.mpto.mp.br/ws/intercomunicacao3.0/wsdl/servico-intercomunicacao-3.0.0.wsdl
URL_BASE_WEBSERVICE=https://app8.mpto.mp.br
# ========================================
# WEBSERVICE CNJ
# ========================================
# URL do webservice CNJ para consulta de classes e assuntos
URL_CNJ_WEBSERVICE=https://www.cnj.jus.br/sgt/sgt_ws.php

# ========================================
# AI CONFIGURATION (OpenRouter)
# ========================================
AI_BATCH_SIZE=10
# Tamanho do lote para análise de documentos (evita erro 413)
# Recomendado: 5-10 para docs grandes, 15-20 médios, 30+ pequenos

OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4
# Modelos recomendados para análise jurídica (via OpenRouter):
# - anthropic/claude-sonnet-4 (análise de documentos, excelente raciocínio)
# - anthropic/claude-3.5-sonnet (raciocínio avançado)
# - openai/gpt-4o (multimodal - texto e imagens)
# - deepseek/deepseek-r1 (pensamento profundo, custo baixo)
# - x-ai/grok-4.1-fast (raciocínio rápido)
OPENROUTER_TIMEOUT=300
OPENROUTER_RATE_LIMIT_PER_MINUTE=30

# ========================================
# VITE (Frontend Assets)
# ========================================
VITE_APP_NAME="${APP_NAME}"

# ========================================
# DOCKER ESPECÍFICO
# ========================================
USER_ID=1000
GROUP_ID=1000
