# ========================================
# CONFIGURAÇÃO DOCKER - SISTEMA DE ANÁLISE DE PROCESSOS
# ========================================

APP_NAME="Painel de Análises Jurídicas"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8000
APP_PORT=8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ========================================
# DATABASE - PostgreSQL
# ========================================
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=painel
DB_USERNAME=painel_user
DB_PASSWORD=strongpassword123

# ========================================
# CACHE & SESSION - Redis
# ========================================
CACHE_STORE=redis
CACHE_PREFIX=painel_cache

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0

# ========================================
# QUEUE - Redis
# ========================================
QUEUE_CONNECTION=redis

# ========================================
# FILESYSTEM
# ========================================
FILESYSTEM_DISK=local

# ========================================
# BROADCASTING
# ========================================
BROADCAST_CONNECTION=log

# ========================================
# MAIL
# ========================================
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@painel.local"
MAIL_FROM_NAME="${APP_NAME}"

# ========================================
# E-PROC WEBSERVICE
# ========================================
# URL do webservice MNI do e-Proc
# URL_SOAP_WEBSERVICE=https://eproc1.tjto.jus.br/eprocV2_prod_1grau/ws/intercomunicacao3.0/wsdl/servico-intercomunicacao-3.0.0.wsdl
# URL_BASE_WEBSERVICE=https://eproc1g-ws.tjto.jus.br/eprocV2_prod_1grau

URL_SOAP_WEBSERVICE=https://app8.mpto.mp.br/ws/intercomunicacao3.0/wsdl/servico-intercomunicacao-3.0.0.wsdl
URL_BASE_WEBSERVICE=https://app8.mpto.mp.br
# ========================================
# WEBSERVICE CNJ
# ========================================
# URL do webservice CNJ para consulta de classes e assuntos
URL_CNJ_WEBSERVICE=https://www.cnj.jus.br/sgt/sgt_ws.php

# ========================================
# AI CONFIGURATION (OpenRouter)
# ========================================
AI_BATCH_SIZE=10
# Tamanho do lote para análise de documentos (evita erro 413)
# Recomendado: 5-10 para docs grandes, 15-20 médios, 30+ pequenos

OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4
# Modelos recomendados para análise jurídica (via OpenRouter):
# - anthropic/claude-sonnet-4 (análise de documentos, excelente raciocínio)
# - anthropic/claude-3.5-sonnet (raciocínio avançado)
# - openai/gpt-4o (multimodal - texto e imagens)
# - deepseek/deepseek-r1 (pensamento profundo, custo baixo)
# - x-ai/grok-4.1-fast (raciocínio rápido)
OPENROUTER_TIMEOUT=300
OPENROUTER_RATE_LIMIT_PER_MINUTE=30

# Roteamento de modelos por tipo de documento (opcional)
# Se vazio, usa OPENROUTER_MODEL para todos os tipos
# OPENROUTER_MODEL_PDF_TEXT=google/gemini-2.5-flash-preview
# OPENROUTER_MODEL_PDF_OCR=anthropic/claude-sonnet-4
# OPENROUTER_MODEL_VISION=anthropic/claude-sonnet-4
# Use :extended para contexto expandido em documentos grandes:
# OPENROUTER_MODEL_LARGE=anthropic/claude-sonnet-4:extended

OPENROUTER_MODEL=x-ai/grok-4.1-fast
OPENROUTER_MODEL_PDF_TEXT=x-ai/grok-4.1-fast
OPENROUTER_MODEL_PDF_OCR=google/gemini-2.5-flash-lite
OPENROUTER_MODEL_VISION=google/gemini-2.5-flash-lite
OPENROUTER_MODEL_LARGE=x-ai/grok-4.1-fast

OPENROUTER_MAX_TOKENS=8192
OPENROUTER_MAX_TOKENS_REASONING=32768
OPENROUTER_MAX_TOKENS_REDUCE=16384
OPENROUTER_MAX_TOKENS_FINAL=16384

# ----------------------------------------
# Provider Routing (resiliência e performance)
# ----------------------------------------
# Ordem de prioridade de providers (separados por vírgula)
# OPENROUTER_PROVIDER_ORDER=anthropic,google,openai
# Permitir fallback automático para outro provider se o primário falhar
OPENROUTER_ALLOW_FALLBACKS=true
# Ordenação de providers: price, throughput, latency (vazio = load balancing padrão)
# Use 'throughput' para priorizar velocidade na fase MAP
# OPENROUTER_PROVIDER_SORT=
# Garantir que o provider suporte todos os parâmetros da request
OPENROUTER_REQUIRE_PARAMETERS=true

# ----------------------------------------
# Controle de custos
# ----------------------------------------
# Teto de preço por 1M tokens (hard limit - request falha se exceder)
# OPENROUTER_MAX_PRICE_PROMPT=10
# OPENROUTER_MAX_PRICE_COMPLETION=30

# ----------------------------------------
# Transforms
# ----------------------------------------
# Compressão automática de contexto (middle-out): remove conteúdo do meio do prompt
# quando excede a janela de contexto do modelo. Valores: 'middle-out' ou vazio para desabilitar
OPENROUTER_TRANSFORMS=middle-out

# ----------------------------------------
# Structured Outputs (fase MAP)
# ----------------------------------------
# Habilita respostas JSON estruturadas na fase MAP para dados consistentes
# Requer modelos compatíveis (GPT-4o+, Gemini, Claude Sonnet 4+)
# Inclui plugin response-healing (grátis) para corrigir JSON malformado
OPENROUTER_STRUCTURED_MAP_ENABLED=false

# ----------------------------------------
# Web Search (parecer final)
# ----------------------------------------
# Habilita consulta a legislação e jurisprudência atualizadas no parecer final
# Custo adicional: ~$0.02/request (Exa) ou pricing nativo do provider
OPENROUTER_WEB_SEARCH_ENABLED=true
OPENROUTER_WEB_SEARCH_MAX_RESULTS=3

# ========================================
# VITE (Frontend Assets)
# ========================================
VITE_APP_NAME="${APP_NAME}"

# ========================================
# DOCKER ESPECÍFICO
# ========================================
USER_ID=1000
GROUP_ID=1000
